<!-- viewer/views/collection.ejs -->
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ChromaDB Collections Viewer - <%= name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>ChromaDB Collections Viewer</h1>
    <nav>
      <a href="/">コレクション一覧に戻る</a>
    </nav>
  </header>
  
  <main>
    <section class="collection-details">
      <h2>コレクション: <%= name %></h2>
      <p>総レコード数: <%= count %></p>

      <div class="search-form">
        <details>
          <summary>検索フォームを表示/非表示</summary>
          <form action="/collection/<%= name %>/search" method="POST">
            <div class="form-group">
              <label for="query">検索クエリ:</label>
              <input type="text" id="query" name="query" required>
            </div>
            <div class="form-group">
              <label for="k">表示件数:</label>
              <input type="number" id="k" name="k" value="10" min="1" max="100">
            </div>
            <button type="submit">検索</button>
          </form>
        </details>
      </div>
      
      <div class="data-table">
        <h3>レコード一覧</h3>
        
        <% if (data && data.ids && data.ids.length > 0) { %>
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>メタデータ</th>
                <th>埋め込みベクトル</th>
                <th>ドキュメント</th>
              </tr>
            </thead>
            <tbody>
              <% for (let i = 0; i < data.ids.length; i++) { %>
                <tr>
                  <td><%= data.ids[i] %></td>
                  <td>
                    <% if (data.metadatas && data.metadatas[i]) { %>
                      <details>
                        <summary>メタデータを表示</summary>
                        <pre class="metadatas"><%= JSON.stringify(data.metadatas[i], null, 2) %></pre>
                      </details>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td>
                    <% if (data.embeddings && data.embeddings[i]) { %>
                      <details>
                        <summary>ベクトルを表示 (<%= data.embeddings[i].length %> 次元)</summary>
                        <pre class="vector"><%= JSON.stringify(data.embeddings[i]) %></pre>
                      </details>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td>
                    <% if (data.documents && data.documents[i]) { %>
                      <details open>
                        <summary>ドキュメントを表示</summary>
                        <pre class="documents"><%= data.documents[i] %></pre>
                      </details>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
          
          <!-- ページネーション -->
          <% if (pages > 1) { %>
            <div class="pagination">
              <% if (page > 1) { %>
                <a href="/collection/<%= name %>?page=<%= page - 1 %>&limit=<%= limit %>">&laquo; 前へ</a>
              <% } %>
              
              <% for (let i = 1; i <= pages; i++) { %>
                <% if (i === page) { %>
                  <span class="current-page"><%= i %></span>
                <% } else { %>
                  <a href="/collection/<%= name %>?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                <% } %>
              <% } %>
              
              <% if (page < pages) { %>
                <a href="/collection/<%= name %>?page=<%= page + 1 %>&limit=<%= limit %>">次へ &raquo;</a>
              <% } %>
            </div>
          <% } %>
          
        <% } else { %>
          <p>このコレクションにはレコードがありません。</p>
        <% } %>
      </div>
    </section>
  </main>
  
  <footer>
    <p>&copy; 2025 ChromaDB Collections Viewer</p>
  </footer>
</body>
</html>