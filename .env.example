# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_VERSION=

# ChromaDB Configuration
CHROMADB_HOST=host.docker.internal
CHROMADB_PORT=8000

# LiteLLM Configuration
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MODEL=azure-text-embedding-ada-002
LITELLM_PORT=4000

# Next.js Viewer Configuration (for local development, use localhost instead of host.docker.internal)
# For Docker: CHROMADB_HOST=host.docker.internal, LITELLM_PROXY_URL=http://litellm:4000
# For Local: CHROMADB_HOST=localhost, LITELLM_PROXY_URL=http://localhost:4000

