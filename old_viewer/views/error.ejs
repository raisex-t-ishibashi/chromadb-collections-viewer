<!-- viewer/views/error.ejs -->
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ChromaDB Collections Viewer - エラー</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>ChromaDB Collections Viewer</h1>
    <nav>
      <a href="/">コレクション一覧に戻る</a>
    </nav>
  </header>
  
  <main>
    <section class="error">
      <h2>エラーが発生しました</h2>
      <p><%= message %></p>
      
      <% if (error) { %>
        <details>
          <summary>エラー詳細</summary>
          <pre><%= JSON.stringify(error, null, 2) %></pre>
        </details>
      <% } %>
    </section>
  </main>
</body>
</html>