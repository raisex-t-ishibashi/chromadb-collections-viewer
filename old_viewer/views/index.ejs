<!-- viewer/views/index.ejs -->
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ChromaDB Collections Viewer</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>ChromaDB Collections Viewer</h1>
  </header>
  
  <main>
    <section class="collections">
      <h2>コレクション一覧</h2>
      
      <% if (collections && collections.length > 0) { %>
        <ul class="collection-list">
          <% collections.forEach(collection => { %>
            <li>
              <a href="/collection/<%= collection.name %>">
                <div class="collection-item">
                  <div class="collection-hierarchy">
                    <span class="tenant">テナント: <%= collection.tenant %></span>
                    <span class="separator">›</span>
                    <span class="database">データベース: <%= collection.database %></span>
                    <span class="separator">›</span>
                    <span class="collection-name">コレクション: <%= collection.name %></span>
                  </div>
                  <div class="collection-id">ID: <%= collection.id %></div>
                </div>
              </a>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p>コレクションがありません。ChromaDBにデータを追加してください。</p>
      <% } %>
    </section>
  </main>
</body>
</html>